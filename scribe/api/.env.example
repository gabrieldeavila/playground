PORT=3199
# Only this machine can call the API: it edits docs with your Google account
HOST=127.0.0.1
# The whisper UI, the only browser origin allowed to call the API
UI_URL=http://localhost:3100
# OAuth client ("Web application") from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI of the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3199/auth/callback
# Where the refresh token is saved after logging in
GOOGLE_TOKEN_PATH=.google-token.json
# Google Picker: an API key and the Cloud project NUMBER (not its id)
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Summaries are written by Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
