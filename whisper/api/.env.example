PORT=3099
UI_URL=http://localhost:3100
# Whisper model (tiny, base, small, medium, large-v3-turbo, ...)
WHISPER_MODEL=small
# Spoken language; "auto" detects it per chunk (slower, less accurate)
WHISPER_LANGUAGE=pt
# Where models are stored/downloaded; defaults to inside node_modules
# WHISPER_MODEL_DIR=/models
